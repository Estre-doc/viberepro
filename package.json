{
  "name": "viberepro",
  "version": "0.1.0",
  "description": "Turn browser bugs into an offline evidence pack your coding agent can use.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Estre-doc/viberepro.git" },
  "homepage": "https://github.com/Estre-doc/viberepro#readme",
  "bugs": { "url": "https://github.com/Estre-doc/viberepro/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "bin": { "viberepro": "dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "LICENSE", "THIRD_PARTY_NOTICES.txt", "docs/DEPENDENCIES.json"],
  "engines": { "node": ">=22.13.0" },
  "packageManager": "pnpm@11.25.0",
  "keywords": ["playwright", "browser", "debugging", "codex", "claude-code", "bug-report", "cli"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src report-ui tests scripts",
    "test": "pnpm build && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm licenses:check",
    "demo": "node examples/bug-lab/server.mjs",
    "demo:scan": "node dist/cli.js http://127.0.0.1:4173 --out demo-report",
    "demo:generate": "pnpm build && node scripts/capture-demo.mjs",
    "scan": "node dist/cli.js",
    "browser:install": "playwright install chromium",
    "names:check": "node scripts/check-names.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "licenses:generate": "node scripts/licenses.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "pnpm build && pnpm licenses:check"
  },
  "dependencies": { "playwright": "1.64.1" },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
